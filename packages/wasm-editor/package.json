{
  "name": "@tantaman/wasm-editor",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./editor.css": "./src/editor.css"
  },
  "scripts": {
    "wasm": "node scripts/assemble.mjs",
    "dev": "node scripts/assemble.mjs && vite",
    "build": "node scripts/assemble.mjs && vite build",
    "test": "node scripts/assemble.mjs && node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "desktop": "node scripts/assemble.mjs && cargo run --release --manifest-path desktop/Cargo.toml --"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@types/node": "^24.10.1",
    "fontkit": "^2.0.4",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "wabt": "^1.0.39"
  }
}
