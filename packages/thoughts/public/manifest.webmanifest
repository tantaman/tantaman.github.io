{
  "name": "Tantaman Thoughts",
  "short_name": "Thoughts",
  "description": "Capture thoughts, amplifications, and bookmarks to tantaman.com",
  "start_url": "/thoughts/",
  "scope": "/thoughts/",
  "display": "standalone",
  "theme_color": "#1a73e8",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "/img/avatar-icon.png",
      "sizes": "312x369",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/avatar-icon-hires.png",
      "sizes": "1024x1536",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/thoughts/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
