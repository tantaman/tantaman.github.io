{
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "engines": {
    "node": ">=17",
    "pnpm": ">=3"
  },
  "dependencies": {
    "@tantaman/sitecompiler": "workspace:*",
    "rehype-meta": "^3.2.1",
    "rehype-parse": "^8.0.5",
    "rehype-stringify": "^9.0.3",
    "serve": "^13.0.2",
    "sharp": "^0.34.5",
    "unified": "^10.1.2"
  },
  "scripts": {
    "build": "cd packages/facets && pnpm build && cd ../compiler && pnpm build && cd ../frontend && pnpm build && cd ../thoughts && pnpm build && cd ../posts && pnpm build && cd ../dha-report-app && pnpm build && cd ../.. && sitecompiler",
    "build:cloudflare": "cd worker",
    "deploy:cloudflare": "cd worker && wrangler publish",
    "dev": "sitecompiler-watch",
    "serve": "cd docs && serve",
    "fetch-chat": "fetch-chat",
    "relationships": "cd packages/compiler && pnpm build && cd ../.. && relationships",
    "search-index": "cd packages/compiler && pnpm build && cd ../.. && search-index",
    "chat-embeddings": "node scripts/generate-embeddings.mjs",
    "summaries": "node scripts/generate-summaries.mjs",
    "theses": "node scripts/generate-theses.mjs",
    "thought-projection": "node scripts/compute-thought-projection.mjs",
    "todos": "leasot '**/*.ts' --ignore '**/node_modules'",
    "preinstall": "npx only-allow pnpm",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.3.1",
    "turndown": "^7.2.2"
  }
}
