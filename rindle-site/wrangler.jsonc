{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tantamanlands",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-07-21",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "tantaman.com/*",
			"zone_name": "tantaman.com"
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"AUTH_TRUSTED_ORIGINS": "https://tantaman.com,https://tantamanlands.tantaman.workers.dev"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	// Auth is deliberately separate from the Rindle content database. Omitting database_id lets
	// Wrangler provision the D1 database on first deploy; it can be pinned here later if desired.
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "rindle-site-auth",
			"migrations_dir": "./migrations-auth",
			"database_id": "a2da5bad-550c-4cb1-a952-5755aa8f5baf"
		}
	]
	// Server-only configuration is set with Wrangler secrets or dashboard variables, never committed:
	//   BETTER_AUTH_URL, BETTER_AUTH_SECRET, TANTAMAN_OWNER_EMAIL
	//   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET and/or GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
	//   RINDLE_URL, RINDLE_DATABASE_TOKEN, optional RINDLE_WS_URL
	//   optional MAPBOX_TOKEN, TMDB_API_KEY for structured thought metadata
}
