# Normal `pnpm dev` (Node + local auth-local.db). Rindle injects its own URL/token.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
TANTAMAN_OWNER_EMAIL=you@example.com

# Configure at least one social provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated additional origins accepted by Better Auth.
AUTH_TRUSTED_ORIGINS=
