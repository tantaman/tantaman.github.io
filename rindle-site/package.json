{
  "name": "rindle-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A SQL-first Rindle app on TanStack Start — generated by create-rindle.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "dev": "rindle dev --migrate --gen shared/schema.gen.ts --dir migrations -- vite dev --port 3000",
    "generate-routes": "tsr generate",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "vite build",
    "prebuild:cf": "node scripts/sync-assets.mjs",
    "build:cf": "CF=1 vite build",
    "preview": "vite preview",
    "preview:cf": "CF=1 vite preview",
    "deploy": "pnpm build:cf && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:migrate": "wrangler d1 migrations apply rindle-site-auth --local",
    "auth:migrate:remote": "wrangler d1 migrations apply rindle-site-auth --remote",
    "migrate": "rindle migrate apply --dir migrations",
    "seed": "rindle exec -- node scripts/seed-posts.mjs",
    "import:thoughts": "rindle exec -- node scripts/import-thoughts.mjs",
    "import:pastes": "rindle exec -- node scripts/import-pastes.mjs",
    "import:comments": "rindle exec -- node scripts/import-comments.mjs",
    "seed:prod": "node --env-file=.env scripts/seed-posts.mjs",
    "import:thoughts:prod": "node --env-file=.env scripts/import-thoughts.mjs",
    "import:pastes:prod": "node --env-file=.env scripts/import-pastes.mjs",
    "import:comments:prod": "node --env-file=.env scripts/import-comments.mjs",
    "rindle:deploy": "rindle deploy",
    "rindle:migrate:remote": "rindle migrate apply --remote",
    "typecheck": "tsr generate && tsc --noEmit"
  },
  "dependencies": {
    "@rindle/api-server": "0.7.8",
    "@rindle/client": "0.7.8",
    "@rindle/optimistic": "0.7.8",
    "@rindle/react": "0.7.8",
    "@rindle/wasm": "0.7.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/markdown": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@xyflow/react": "12.10.2",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sucrase": "^3.35.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@rindle/cli": "0.7.8",
    "@rindle/devtools": "0.7.8",
    "@rindle/react-devtools": "0.7.8",
    "@rindle/sql-client": "0.7.8",
    "@tanstack/router-cli": "^1.167.17",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "gray-matter": "^4.0.3",
    "marked": "^16.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "wrangler": "^4.112.0"
  }
}
