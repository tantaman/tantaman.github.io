#!/bin/sh
echo "Pre-push: building thoughts..."
cd packages/thoughts && pnpm build && cd ../..

if ! git diff --quiet docs/thoughts/; then
  echo ""
  echo "ERROR: docs/thoughts/ has uncommitted changes after build."
  echo "Please commit the updated build output before pushing."
  echo ""
  exit 1
fi

