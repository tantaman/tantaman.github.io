#!/bin/sh
echo "Pre-push: building changed frontends..."
node scripts/build-frontends.mjs thoughts lists comments wardrobe || exit 1

for proj in thoughts lists comments wardrobe; do
  if ! git diff --quiet "docs/$proj/"; then
    echo ""
    echo "ERROR: docs/$proj/ has uncommitted changes after build."
    echo "Please commit the updated build output before pushing."
    echo ""
    exit 1
  fi
done
