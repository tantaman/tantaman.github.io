    { "id": "nominalistSci", "label": "Nominalist Turn", "sub": "Ockham's razor \u00b7 14th c.", "col": 1, "h": 75, "color": "#d48a4e", "score": 22, "note": "Universals don't exist \u2014 only particular measurable things are real" },
