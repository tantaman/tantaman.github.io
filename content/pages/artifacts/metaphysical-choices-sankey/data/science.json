    { "id": "darwin", "label": "Darwin / Evolutionary", "sub": "Origin of Species \u00b7 1859", "col": 3, "h": 55, "color": "#b8924a", "score": 45, "note": "Ambiguous \u2014 nature has depth and creativity, but no telos; disenchanting" },
