    { "id": "bacon", "label": "Francis Bacon", "sub": "'Knowledge is power' \u00b7 1620", "col": 2, "h": 70, "color": "#d48a4e", "score": 15, "note": "THE FORK \u2014 science redefined as control over nature, not participation in it" },
    { "id": "descartes", "label": "Descartes", "sub": "Res cogitans / res extensa \u00b7 1637", "col": 2, "h": 75, "color": "#cc6644", "score": 12, "note": "Mind-body split \u2014 nature becomes dead matter, mind becomes spectator" },
    { "id": "newton", "label": "Newton", "sub": "Principia \u00b7 1687", "col": 2, "h": 80, "color": "#b8924a", "score": 40, "note": "Genuinely both \u2014 occult alchemist AND mechanist; the tension is the man" },
    { "id": "romanticSci", "label": "Romantic Science", "sub": "Goethe, Humboldt, Schelling", "col": 3, "h": 50, "color": "#3ac5b5", "score": 80, "glow": true, "note": "Nature as living whole \u2014 the scientist participates in what she studies" },
