    { "id": "ancient", "label": "Ancient Natural Philosophy", "sub": "Thales \u2192 Aristotle \u00b7 thaumazein", "col": 0, "h": 240, "color": "#c9a84c", "score": 75, "note": "Science begins in wonder \u2014 knowing as participation in the intelligibility of the cosmos" },
